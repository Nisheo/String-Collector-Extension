{
  "manifest_version": 3,
  "name": "GitHub String Collector",
  "version": "0.1.0",
  "description": "Collect localization strings from GitHub pull requests.",
  "permissions": [  
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://patch-diff.githubusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}